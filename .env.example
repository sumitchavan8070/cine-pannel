ENVIRONMENT=local
NEXT_PUBLIC_ENVIRONMENT=local

# Preferred API URL for the admin panel
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: force absolute API URLs from the browser (disables Next.js rewrite proxy)
# NEXT_PUBLIC_USE_ABSOLUTE_API=true

# Backward-compatible overrides
NEXT_PUBLIC_API_BASE_URL_LOCAL=http://localhost:3001/api
API_BASE_URL_LOCAL=http://localhost:3001/api
NEXT_PUBLIC_API_BASE_URL_LIVE=https://api.cine.fluttertales.tech/api
API_BASE_URL_LIVE=https://api.cine.fluttertales.tech/api

NEXT_PUBLIC_ADMIN_BASE_URL_LOCAL=http://localhost:3000
NEXT_PUBLIC_ADMIN_BASE_URL_LIVE=https://admin.cine.fluttertales.tech
